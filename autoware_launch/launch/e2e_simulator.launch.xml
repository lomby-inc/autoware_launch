<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Essential parameters -->
  <arg name="use_sim_time" default="true" description="use simulation time"/>
  <arg name="map_path" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="sample_vehicle" description="vehicle model name"/>
  <arg name="sensor_model" default="sample_sensor_kit" description="sensor model name"/>
  <arg name="data_path" default="$(env HOME)/autoware_data" description="packages data and artifacts directory path"/>
  <arg name="simulator_type" default="awsim" description="select the simulator type ('awsim' or 'carla')"/>

  <!-- launch module preset -->
  <arg name="planning_module_preset" default="default" description="planning module preset"/>

  <!-- Optional parameters -->
  <!-- Modules to be launched -->
  <arg name="vehicle" default="true" description="launch vehicle"/>
  <arg name="system" default="true" description="launch system"/>
  <arg name="map" default="true" description="launch map"/>
  <arg name="sensing" default="true" description="launch sensing"/>
  <arg name="localization" default="true" description="launch localization"/>
  <arg name="perception" default="true" description="launch perception"/>
  <arg name="planning" default="true" description="launch planning"/>
  <arg name="control" default="true" description="launch control"/>
  <!-- Map -->
  <arg name="lanelet2_map_file" default="lanelet2_map.osm" description="lanelet2 map file name"/>
  <!-- A DIRECTORY of 50 m tiles, not the single pointcloud_map.pcd, and the
       distinction decides whether static structure gets masked at all.
       compare_map_segmentation derives its cell pitch from a cell's own extent,
       so a one-cell map yields a pitch as wide as the map; and it voxelizes each
       cell at a leaf fine enough that a whole-map cell overflows PCL's int32
       guard, which then returns the cloud unchanged. Measured on the untiled
       map: 0 of 2805 points removed per frame, silently. Tiles are generated by
       sim_test/tools/tile_pointcloud_map.py in the lomby_nav2 repo.

       To go back to the untiled map, BOTH arguments have to change:
         pointcloud_map_file:=pointcloud_map.pcd pointcloud_map_metadata_file:=none.yaml
       Changing only the first one makes map_loader abort at startup. Once
       pointcloud_map_metadata.yaml exists it is authoritative, and map_loader
       throws "Missing PCD segments" when the metadata names 198 tiles that a
       single-file path cannot supply, so no map is published at all and NDT
       reports "No InputTarget". Pointing the metadata arg at a file that does
       not exist is what selects map_loader's single-PCD fallback. -->
  <arg name="pointcloud_map_file" default="pointcloud_map" description="pointcloud map file or tile directory name"/>
  <arg name="pointcloud_map_metadata_file" default="pointcloud_map_metadata.yaml" description="pointcloud map metadata file name, relative to map_path. A path that does not exist makes map_loader derive metadata from a single PCD, which is the only way to load an untiled map"/>
  <!-- Perception -->
  <arg name="traffic_light_namespace" default="[traffic_light]" description="traffic light recognition namespace"/>
  <!-- Rule-based clustering, not CenterPoint, is the default here.
       CenterPoint needs CUDA and TensorRT, and where those are missing its package
       builds as an empty stub: the component fails to load. That alone would only
       cost the DNN classes, but the first object_association_merger syncs the DNN
       and clustering channels with message_filters ApproximateTime, which fires
       only when both inputs have a message. So a dead DNN channel stops the merger
       entirely, the tracker receives no detections and publishes empty objects
       forever, and the clustering that is running gets thrown away.
       Setting clustering points both merger inputs at the clustering channel, so
       the pipeline is alive on CPU alone. It has no classifier, so every object
       arrives as UNKNOWN. Pass lidar_detection_model:=centerpoint on a machine
       whose TensorRT this Autoware can actually build against. -->
  <arg name="lidar_detection_model" default="clustering" description="lidar detector. options: `transfusion`, `centerpoint`, `apollo`, `pointpainting`, `clustering`"/>
  <!-- The lanelet object filter is off here, and it has to be for the detector
       above to produce anything. It discards UNKNOWN objects that do not overlap a
       lanelet, and rule-based clustering labels everything UNKNOWN. This map is a
       road map: 884 road lanelets, 84 crosswalks, 8 walkways. Measured on the
       Nishishinjuku footway, the ego sits 5.14 m outside the nearest lanelet
       boundary, so every cluster beside the robot is off-network and the filter
       drops all of them. With it on, clustering produced 10 objects per frame and
       published 0.
       Autoware is not planning here anyway; nav2 is, from the pointcloud costmap.
       So these objects are for observation, and unfiltered is what makes them
       observable. Leave the filter on for any run where Autoware plans. -->
  <arg name="use_object_filter" default="false" description="filter detected objects against the lanelet map"/>
  <arg name="use_moving_object_filter" default="false" description="republish only tracked objects that are actually moving, on .../tracking/moving_objects. Opt-in: it is a noise reducer, not a safety filter -- a standing pedestrian has zero speed and is deliberately absent"/>
  <arg name="pointcloud_map_filter_param_file" default="$(find-pkg-share autoware_launch_lomby)/config/perception/object_recognition/detection/pointcloud_filter/pointcloud_map_filter_sim.param.yaml" description="sim compare_map_segmentation params: the shared file z leaf is too fine for PCL to build a leaf layout, making the filter a no-op"/>
  <!-- Control -->
  <!-- Vehicle -->
  <arg name="launch_vehicle_interface" default="false"/>
  <!-- System -->
  <arg name="launch_system_monitor" default="false" description="launch system monitor"/>
  <arg name="launch_dummy_diag_publisher" default="false" description="launch dummy diag publisher"/>
  <!-- Sensing -->
  <arg name="launch_sensing_driver" default="false"/>
  <!-- Bypass the per-lidar filter chain and let the merge stage read what AWSIM
       emits. With this false, crop_box_filter_self, crop_box_filter_mirror,
       distortion_corrector_node and ring_outlier_filter are not launched at all,
       and concatenate_data subscribes to /sensing/lidar/left|right/pointcloud_raw_ex.

       It has to be pointcloud_raw_ex. AWSIM also publishes pointcloud_raw, which is
       already 16 B and looks like the closer match, but it carries five fields with
       intensity as a FLOAT32 at offset 12 overlapping channel at offset 14.
       concatenate wants at least six fields whose first six match PointXYZIRC
       exactly, so it rejects that topic and publishes nothing at all. The _ex topic
       is PointXYZIRCAEDT, whose first six fields are PointXYZIRC byte for byte.

       What bypassing costs: the concatenated cloud grows from ~10.5 k points to
       ~28 k and every downstream filter pays for it; sweeps are no longer un-skewed
       for ego motion, which was distortion_corrector_node's job and matters most at
       speed since NDT reads this cloud; and stray returns are no longer culled,
       which was 60% of each sweep. The ego footprint is still cropped, by the
       crop_box_filter that sits after the merge. -->
  <arg name="use_lidar_preprocessing" default="true" description="false feeds the merge stage AWSIM's raw pointcloud_raw_ex and skips the four per-lidar filters"/>
  <!-- Time-accumulated lidar cloud, published alongside the normal one on
       /sensing/lidar/concatenated/pointcloud_accumulated by a
       pointcloud_accumulator_node at the tail of the sensor kit chain.

       It is a parallel topic rather than an in-line stage because the node
       round-trips through pcl::PointXYZ and drops intensity/return_type/channel.
       Every preprocessor filter on the fast API path (the perception crop_box and
       the NDT voxel_grid/random downsamplers included) rejects a frame that is
       not PointXYZIRC/PointXYZIRCAEDT and logs "The pointcloud layout is not
       compatible ... Aborting", so feeding it into concatenated/pointcloud would
       take out perception and localization together. Nothing subscribes to the
       accumulated topic by default; point a layout-agnostic consumer (rviz, a
       nav2 costmap layer) at it to use it.

       accumulator_frame is where the sweeps are buffered and must stay
       world-fixed. The node sums its buffer with a plain `+=` and no per-cloud
       pose correction, so buffering in base_link would stack a 2 s old sweep onto
       the current pose and smear by however far the robot travelled. This TF tree
       is map -> base_link with no odom, so map is the only choice; the cost is
       ~1 cm of float32 quantisation at this map's MGRS offset, and no output
       until localization is up.

       These four reach the sensor kit by launch-configuration propagation:
       tier4_sensing_launch sits in between and forwards only its own fixed arg
       list, so they are not passed down hop by hop. -->
  <arg name="use_pointcloud_accumulator" default="true" description="publish a time-accumulated lidar cloud on /sensing/lidar/concatenated/pointcloud_accumulated"/>
  <arg name="accumulator_frame" default="map" description="world-fixed frame the sweeps are buffered in; base_link here would smear the result by the distance travelled"/>
  <arg name="accumulation_time_sec" default="0.5" description="length of the sliding accumulation window. This is the declaration that wins: it is the outermost, and a launch argument keeps the first value it is given"/>
  <arg name="pointcloud_buffer_size" default="30" description="max sweeps held; must cover accumulation_time_sec x input rate (10 Hz here)"/>
  <!-- Tools -->
  <arg name="rviz" default="true" description="launch rviz"/>
  <arg name="rviz_config" default="$(find-pkg-share autoware_launch_lomby)/rviz/autoware.rviz" description="rviz config"/>
  <log message="perception: lidar_detection_model=$(var lidar_detection_model), use_object_filter=$(var use_object_filter)"/>
  <group scoped="false" if="$(eval '\'$(var simulator_type)\' == \'carla\'')">
    <include file="$(find-pkg-share autoware_carla_interface)/autoware_carla_interface.launch.xml"/>
  </group>

  <group scoped="false">
    <include file="$(find-pkg-share autoware_launch_lomby)/launch/autoware.launch.xml">
      <!-- Common -->
      <arg name="map_path" value="$(var map_path)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <arg name="sensor_model" value="$(var sensor_model)"/>
      <arg name="data_path" value="$(var data_path)"/>
      <!-- launch module preset -->
      <arg name="planning_module_preset" value="$(var planning_module_preset)"/>
      <!-- Modules to be launched -->
      <arg name="launch_vehicle" value="$(var vehicle)"/>
      <arg name="launch_map" value="$(var map)"/>
      <arg name="launch_sensing" value="$(var sensing)"/>
      <arg name="launch_localization" value="$(var localization)"/>
      <arg name="launch_perception" value="$(var perception)"/>
      <arg name="launch_planning" value="$(var planning)"/>
      <arg name="launch_control" value="$(var control)"/>
      <!-- Global parameters -->
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <!-- Vehicle -->
      <arg name="launch_vehicle_interface" value="$(var launch_vehicle_interface)"/>
      <!-- Map -->
      <arg name="lanelet2_map_file" value="$(var lanelet2_map_file)"/>
      <arg name="pointcloud_map_file" value="$(var pointcloud_map_file)"/>
      <arg name="pointcloud_map_metadata_file" value="$(var pointcloud_map_metadata_file)"/>
      <!-- System -->
      <arg name="launch_system_monitor" value="$(var launch_system_monitor)"/>
      <arg name="launch_dummy_diag_publisher" value="$(var launch_dummy_diag_publisher)"/>
      <arg name="diagnostic_graph_aggregator_graph_path" value="$(find-pkg-share autoware_launch_lomby)/config/system/diagnostic_graph_aggregator/autoware-awsim.yaml"/>
      <!-- Sensing -->
      <arg name="launch_sensing_driver" value="$(var launch_sensing_driver)"/>
      <!-- Perception-->
      <arg name="traffic_light_recognition/enable_fine_detection" value="false"/>
      <arg name="all_traffic_light_camera" value="$(var traffic_light_namespace)"/>
      <arg name="lidar_detection_model" value="$(var lidar_detection_model)"/>
      <arg name="use_object_filter" value="$(var use_object_filter)"/>
      <arg name="pointcloud_map_filter_param_file" value="$(var pointcloud_map_filter_param_file)"/>
      <arg name="use_moving_object_filter" value="$(var use_moving_object_filter)"/>
      <!-- Tools -->
      <arg name="rviz" value="$(var rviz)"/>
      <arg name="rviz_config" value="$(var rviz_config)"/>
    </include>
  </group>
</launch>
